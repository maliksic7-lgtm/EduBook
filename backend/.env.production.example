# ============================================================
# EduBook — Contoh Environment PRODUKSI (untuk Render dkk)
# Salin nilainya ke Env Vars di dashboard Render.
# JANGAN commit file berisi nilai asli; file ini hanya placeholder.
# ============================================================

# Server
PORT=5000

# Database (MongoDB Atlas M0)
# Buat di https://www.mongodb.com/atlas lalu isi connection string:
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/edubook
ALLOW_DESTRUCTIVE_SEED=false

# Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# GANTI ke domain backend Render kamu:
GOOGLE_CALLBACK_URL=https://CHANGE_ME_API.onrender.com/api/auth/google/callback

# JWT / Session (pakai string acak panjang, mis. dari: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_value
SESSION_SECRET=replace_with_a_long_random_value

# Frontend URL (domain Netlify kamu — redirect setelah login Google)
FRONTEND_URL=https://CHANGE_ME_APP.netlify.app

# Admin API (untuk endpoint reset/cache/penambahan buku)
ADMIN_API_KEY=replace_with_a_long_random_value

# CORS — izinkan domain frontend Netlify (+ domain kustom bila ada)
CORS_ORIGINS=https://CHANGE_ME_APP.netlify.app
CORS_ALLOW_NULL_ORIGIN=false

# MQTT Broker publik (firmware ESP32 memakai broker.hivemq.com)
# Untuk produksi lebih aman: broker privat dengan mqtts://
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC_PREFIX=edubook/demo
MQTT_USERNAME=
MQTT_PASSWORD=
