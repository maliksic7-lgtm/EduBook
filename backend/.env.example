# Server
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/edubook
ALLOW_DESTRUCTIVE_SEED=false

# Google Gemini AI
# Dapatkan API key dari https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth (dapatkan dari https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# JWT Secret (gunakan string acak yang panjang)
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# Frontend URL (untuk redirect setelah login)
FRONTEND_URL=http://127.0.0.1:5500

# Admin API (wajib untuk endpoint reset, cache, dan penambahan buku)
ADMIN_API_KEY=replace_with_a_long_random_value

# CORS
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
CORS_ALLOW_NULL_ORIGIN=true

# MQTT Broker (gunakan broker privat/TLS untuk deployment)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC_PREFIX=edubook/demo
MQTT_USERNAME=
MQTT_PASSWORD=
